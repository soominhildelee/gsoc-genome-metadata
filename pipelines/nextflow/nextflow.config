/*
 * Config for the assembly-metadata Nextflow workflow.
 * Override any param on the CLI, e.g.:
 *   nextflow run main.nf --accessions ../../accessions.txt --gemma_enabled 1
 */

params {
    // Input accession list (one per line; "# ..." comments allowed).
    accessions    = "${projectDir}/../../accessions.txt"

    // Where the Python package (pipeline.py) lives — repo root by default.
    pipeline_dir  = "${projectDir}/../.."

    // Conda env that has the pipeline's dependencies installed.
    conda_env     = 'ensembl'

    // Passed through to pipeline.py.
    max_results   = 3

    // 0 = rule + vector only (fast); 1 = also run the local Gemma layer.
    gemma_enabled = 0

    outdir        = "${projectDir}/results"

    // Cap concurrent NCBI / Europe PMC calls to stay under rate limits.
    max_forks     = 3
}

process {
    // Rate-limit the API-bound extraction step.
    withName: EXTRACT_METADATA {
        maxForks = params.max_forks
    }
}

// A timeline / report makes it easy to see where time goes across accessions.
timeline { enabled = true; file = "${params.outdir}/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/report.html";   overwrite = true }
